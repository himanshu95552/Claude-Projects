# Copy this file to .env.local for local development, or set these as
# real environment variables in your hosting provider (Vercel, etc).
# See docs/SETUP.md for the full walkthrough of where each value comes from.

# ---- Required ----------------------------------------------------------

# Postgres connection string. Works with a local Postgres, or a hosted one
# (Supabase / Neon). Example for the local dev DB set up by docs/SETUP.md:
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/alphanodus_advocacy

APP_URL=http://localhost:3000

# Signs session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-32-byte-secret

# Encrypts OAuth tokens at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-to-a-random-32-byte-key

# Protects POST /api/cron/nightly-generation from public invocation.
# Generate with: openssl rand -hex 24
CRON_SECRET=change-me

# ---- Optional: email delivery for magic links --------------------------
# Without this, magic links are printed to the server console (dev only).
RESEND_API_KEY=
MAIL_FROM="Alpha Nodus Advocacy <onboarding@yourdomain.com>"

# ---- Optional: Claude API (generation) ----------------------------------
# Without this, the app runs in DEMO_MODE: queues can still be built and
# reviewed, but the nightly job produces clearly-labeled placeholder drafts
# instead of calling the API. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_DRAFTING_MODEL=claude-sonnet-5
ANTHROPIC_RESEARCH_MODEL=claude-haiku-4-5
MONTHLY_SPEND_CAP_USD=30

# ---- Optional: LinkedIn OAuth (Share on LinkedIn / w_member_social) ----
# Without these, queue items still render but Post buttons are disabled
# with an explanation; connect-account flow shows setup instructions.
# Register at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---- Optional: Meta (Instagram + Facebook Graph API), phase 6 ----------
META_APP_ID=
META_APP_SECRET=

# ---- Optional: Web Push (VAPID) -----------------------------------------
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourdomain.com
